# ── TokZeth Desktop — .env.example ─────────────────────────
# Copy this file to .env in the same directory (desktop/)
# Values are read by Electron at runtime (main + preload)

# Required — your DeepSeek API key
# Get one at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional — use OpenAI/Gemini/etc via ACTIVE_PROVIDER (currently only deepseek implemented)
ACTIVE_PROVIDER=deepseek

# Optional — override model (default: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat
