{
  "appId": "com.tokzeth.desktop",
  "productName": "TokZeth",
  "directories": {
    "output": "release",
    "app": "."
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "node_modules/**/*"
  ],
  "win": {
    "target": ["nsis"],
    "icon": "desktop/renderer/public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": true,
    "license": "LICENSE"
  },
  "publish": null,
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.productivity"
  }
}
