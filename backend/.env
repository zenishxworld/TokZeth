# Server
PORT=3001
NODE_ENV=development

# CORS — set to your extension ID and web URL
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://YOUR_EXTENSION_ID

# AI Providers
DEEPSEEK_API_KEY=sk-f37652e9c01c486eb5ea85601c8512fd
